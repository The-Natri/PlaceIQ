# Copy this file to .env at the project root and adjust if needed.
# All three components (db/seed.py, backend/, ml-service/) read from this
# single .env so connection settings never drift out of sync between them.

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://placement_admin:placement_dev_password@localhost:5432/placement_db

# Signs and verifies login tokens (JWTs). Anyone who knows it can forge an
# admin login, so it must be long and random. start.ps1 / start.sh generate
# one into your .env automatically; the backend refuses to start with this
# placeholder. To make one by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

# 1 = Flask debug mode (auto-reload + interactive debugger). Keep 0 unless
# you are actively developing: the debugger can run arbitrary code.
FLASK_DEBUG=0

# The app and the API share one origin (http://localhost:8080), so CORS is
# off. Only set this if the frontend is hosted on another origin:
# FRONTEND_ORIGINS=https://my-frontend.example.com

# Where the app listens. 127.0.0.1 = this machine only.
# HOST=127.0.0.1
# PORT=8080

# Where the main backend reaches the ML microservice for /predict calls.
ML_SERVICE_URL=http://localhost:6000
